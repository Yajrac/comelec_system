# Generate your own key. Do not copy real credentials into version control.
DJANGO_SECRET_KEY=replace-with-your-own-secret-key
DJANGO_DEBUG=True

# Keep sqlite until a compatible server is ready.
# Django 5.2 requires MySQL 8.0.11+ or MariaDB 10.5+.
DB_ENGINE=sqlite
DB_NAME=comelec_system
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
